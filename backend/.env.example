# App
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# Local data
DATABASE_URL=sqlite+aiosqlite:///./canto.db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MINUTES=60
LOCAL_DATA_DIR=./local_data
LOCAL_AUDIO_DIR=./local_data/audio
LOCAL_USER_DIR=./local_data/user

# Qwen / DashScope (backend only — never ship to mobile)
DASHSCOPE_API_KEY=sk-xxx
QWEN_REALTIME_MODEL=qwen3.5-omni-plus-realtime
QWEN_TTS_MODEL=qwen3-tts-flash-realtime
QWEN_TTS_VOICE=Kiki
QWEN_REALTIME_URL=wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime

# cantonese.ai TTS (backend only)
CANTONESE_AI_API_KEY=
CANTONESE_AI_VOICE_ID=50a9a698-1f99-437c-a07d-9cad435c5f8a
CANTONESE_AI_TTS_MODEL=v6

# Limits
MAX_CONVERSATION_MINUTES=15
MAX_SPEECH_REQUESTS_PER_HOUR=60
RATE_LIMIT_ENABLED=true
