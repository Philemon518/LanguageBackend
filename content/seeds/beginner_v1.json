    {
      "id": "sound-01-water",
      "unit_id": "unit-sound",
      "title": "Water — seoi2 — 水",
      "lesson_type": "sound",
      "sort_order": 1,
      "objectives": ["obj-hear-tone-2", "obj-jyutping-seoi2", "obj-char-water"],
      "content": {
        "vocabulary": [{"lexeme_id": "lex-water", "english": "water"}],
        "steps": [
          {
            "id": "s1-hear",
            "type": "select_meaning",
            "skill": "listening",
            "prompt": "Listen. What does this word mean?",
            "audio": {"text": "水", "url": null},
            "options": [
              {"id": "a", "label": "water"},
              {"id": "b", "label": "fire"},
              {"id": "c", "label": "mountain"}
            ],
            "correct_option_id": "a",
            "reveal_jyutping": "seoi2",
            "reveal_character": "水",
            "metadata": {"objective_id": "obj-hear-tone-2"}
          },
          {
            "id": "s2-tone",
            "type": "select_tone",
            "skill": "listening",
            "prompt": "Which tone do you hear?",
            "audio": {"text": "seoi2"},
            "options": [
              {"id": "t1", "label": "Tone 1 (flat high)"},
              {"id": "t2", "label": "Tone 2 (rising)"},
              {"id": "t3", "label": "Tone 3 (mid level)"}
            ],
            "correct_option_id": "t2",
            "reveal_jyutping": "seoi2",
            "metadata": {"objective_id": "obj-hear-tone-2"}
          },
          {
            "id": "s3-jyutping",
            "type": "select_jyutping",
            "skill": "listening",
            "prompt": "Match the sound to Jyutping",
            "audio": {"text": "水"},
            "options": [
              {"id": "j1", "label": "seoi2", "jyutping": "seoi2"},
              {"id": "j2", "label": "seoi1", "jyutping": "seoi1"},
              {"id": "j3", "label": "soeng2", "jyutping": "soeng2"}
            ],
            "correct_option_id": "j1",
            "reveal_character": "水",
            "metadata": {"objective_id": "obj-jyutping-seoi2"}
          },
          {
            "id": "s4-speak",
            "type": "speak",
            "skill": "speaking",
            "prompt": "Say: seoi2 (水 — water)",
            "reveal_jyutping": "seoi2",
            "reveal_character": "水",
            "metadata": {"expected": "seoi2", "objective_id": "obj-char-water"}
          },
          {
            "id": "s5-character",
            "type": "select_character",
            "skill": "reading",
            "prompt": "Which character matches seoi2?",
            "options": [
              {"id": "c1", "label": "水"},
              {"id": "c2", "label": "火"},
              {"id": "c3", "label": "山"}
            ],
            "correct_option_id": "c1",
            "reveal_english": "water",
            "metadata": {"objective_id": "obj-char-water"}
          }
        ]
      }
    },
